#!/usr/bin/env bash
set -euo pipefail

VERSION="2026.08.25.10"
REPO_BASE_URL="${CHECK_CPU_STEAL_REPO_BASE_URL:-https://raw.githubusercontent.com/Coloded/steal/main}"
REPO_COMMIT_API_URL="${CHECK_CPU_STEAL_REPO_COMMIT_API_URL:-https://api.github.com/repos/Coloded/steal/commits/main}"
lang="en"

for arg in "$@"; do
  case "$arg" in
    -ru|--ru)
      lang="ru"
      break
      ;;
  esac
done

usage() {
  if [[ "$lang" == "ru" ]]; then
    cat <<'EOF'
Использование:
  check_cpu_steal [user@]host [-p port] [-s seconds] [--stress|--no-stress|--stress-auto] [-ru]
  check_cpu_steal --update [-ru]
  check_cpu_steal --version

Если host не указан, скрипт спросит его интерактивно.
Авторизация работает как обычный ssh: ключи, ssh-agent, ~/.ssh/config,
и запрос пароля, если сервер разрешает вход по паролю.

По умолчанию включен --stress-auto: если CPU простаивает больше 50%,
скрипт запустит CPU-нагрузку на все найденные vCPU, измерит steal
и остановит нагрузку перед выходом.
EOF
  else
    cat <<'EOF'
Usage:
  check_cpu_steal [user@]host [-p port] [-s seconds] [--stress|--no-stress|--stress-auto] [-ru]
  check_cpu_steal --update [-ru]
  check_cpu_steal --version

If host is not provided, the script asks for it interactively.
SSH auth works exactly like normal ssh: keys, ssh-agent, ~/.ssh/config,
and password prompt if the server allows password login.

By default --stress-auto is enabled: if CPU idle is above 50%, the script
starts CPU load on all detected vCPUs, measures steal, and stops the load
before exit.
EOF
  fi
}

say() {
  local en="$1"
  local ru="$2"
  if [[ "$lang" == "ru" ]]; then
    echo "$ru"
  else
    echo "$en"
  fi
}

download() {
  local url="$1"
  local dest="$2"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$dest"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$dest" "$url"
  else
    say "curl or wget is required for update." "Для обновления нужен curl или wget." >&2
    exit 1
  fi
}

with_cache_buster() {
  local url="$1"
  case "$url" in
    http://*|https://*)
      printf '%s?ts=%s\n' "$url" "$(date +%s)"
      ;;
    *)
      printf '%s\n' "$url"
      ;;
  esac
}

file_version() {
  local file="$1"
  awk -F\" '/^VERSION=/ { print $2; exit }' "$file"
}

resolve_update_base_url() {
  local tmp_meta sha

  if [[ -n "${CHECK_CPU_STEAL_REPO_BASE_URL:-}" ]]; then
    printf '%s\n' "$REPO_BASE_URL"
    return
  fi

  tmp_meta="$(mktemp)"
  download "$(with_cache_buster "$REPO_COMMIT_API_URL")" "$tmp_meta"
  sha="$(awk -F\" '/"sha":/ { print $4; exit }' "$tmp_meta")"
  rm -f "$tmp_meta"

  if [[ -n "$sha" ]]; then
    printf 'https://raw.githubusercontent.com/Coloded/steal/%s\n' "$sha"
  else
    printf '%s\n' "$REPO_BASE_URL"
  fi
}

self_update() {
  local tmp_script tmp_installer remote_version update_base_url install_args=()

  tmp_script="$(mktemp)"
  tmp_installer="$(mktemp)"
  trap 'rm -f "$tmp_script" "$tmp_installer"' EXIT

  say "Checking latest version on GitHub..." "Проверяю свежую версию на GitHub..."
  update_base_url="$(resolve_update_base_url)"
  download "$(with_cache_buster "${update_base_url}/check_cpu_steal")" "$tmp_script"
  remote_version="$(file_version "$tmp_script")"

  if [[ -z "$remote_version" ]]; then
    say "Could not detect remote version." "Не удалось определить версию на GitHub." >&2
    exit 1
  fi

  if [[ "$remote_version" == "$VERSION" ]]; then
    say "Already latest: $VERSION" "У вас уже последняя версия: $VERSION"
    exit 0
  fi

  say "New version available: $VERSION -> $remote_version" "Доступна новая версия: $VERSION -> $remote_version"
  say "Downloading installer..." "Скачиваю installer..."
  download "$(with_cache_buster "${update_base_url}/install.sh")" "$tmp_installer"

  if [[ "$lang" == "ru" ]]; then
    install_args+=("-ru")
  fi

  say "Running installer..." "Запускаю installer..."
  bash "$tmp_installer" "${install_args[@]}"
}

target=""
port="22"
seconds="15"
stress_mode="auto"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -ru|--ru)
      lang="ru"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --version)
      echo "$VERSION"
      exit 0
      ;;
    --update|-update)
      self_update
      exit 0
      ;;
    -p|--port)
      port="${2:-}"
      shift 2
      ;;
    -s|--seconds)
      seconds="${2:-}"
      shift 2
      ;;
    --stress)
      stress_mode="yes"
      shift
      ;;
    --no-stress)
      stress_mode="no"
      shift
      ;;
    --stress-auto)
      stress_mode="auto"
      shift
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "$target" ]]; then
        if [[ "$lang" == "ru" ]]; then
          echo "Можно проверить только один host за раз." >&2
        else
          echo "Only one host can be checked at a time." >&2
        fi
        exit 2
      fi
      target="$1"
      shift
      ;;
  esac
done

if [[ -z "$target" ]]; then
  if [[ "$lang" == "ru" ]]; then
    read -r -p "Имя сервера или IP (можно user@host): " target
  else
    read -r -p "Server name or IP (user@host also works): " target
  fi
fi

if [[ -z "$target" ]]; then
  if [[ "$lang" == "ru" ]]; then
    echo "Сервер не указан." >&2
  else
    echo "No server specified." >&2
  fi
  exit 2
fi

if [[ -z "$seconds" ]]; then
  seconds="15"
fi

if ! [[ "$seconds" =~ ^[0-9]+$ ]] || [[ "$seconds" -lt 2 ]]; then
  if [[ "$lang" == "ru" ]]; then
    echo "Время замера должно быть целым числом >= 2." >&2
  else
    echo "Measurement time must be an integer >= 2." >&2
  fi
  exit 2
fi

ssh_args=()
if [[ -n "$port" ]]; then
  ssh_args+=("-p" "$port")
fi

if [[ "$lang" == "ru" ]]; then
  echo "Подключаюсь к $target..."
  echo "Меряю CPU steal ${seconds}s..."
else
  echo "Connecting to $target..."
  echo "Measuring CPU steal for ${seconds}s..."
fi
echo

ssh "${ssh_args[@]}" "$target" 'bash -s' -- "$seconds" "$stress_mode" "$lang" <<'REMOTE'
set -euo pipefail

seconds="$1"
stress_mode="$2"
lang="$3"
stress_pids=()

say() {
  local en="$1"
  local ru="$2"
  if [[ "$lang" == "ru" ]]; then
    echo "$ru"
  else
    echo "$en"
  fi
}

if [[ ! -r /proc/stat ]]; then
  say "This check needs Linux /proc/stat. The remote OS does not expose it." "Для проверки нужен Linux /proc/stat. На удаленной ОС его нет." >&2
  exit 1
fi

cleanup() {
  if (( ${#stress_pids[@]} > 0 )); then
    kill "${stress_pids[@]}" >/dev/null 2>&1 || true
    wait "${stress_pids[@]}" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

read_cpu() {
  awk '
    /^cpu / {
      total = 0
      for (i = 2; i <= NF; i++) total += $i
      print total, $9
      exit
    }
  ' /proc/stat
}

format_pct() {
  local x100="$1"
  printf '%d.%02d%%' "$((x100 / 100))" "$((x100 % 100))"
}

interpret() {
  local x100="$1"
  if [[ "$lang" == "ru" ]]; then
    if (( x100 < 100 )); then
      echo "Excellent: все отлично, CPU steal почти нет (нормально)."
    elif (( x100 < 300 )); then
      echo "Good: все хорошо, CPU steal низкий (так себе только если повторяется в пиках)."
    elif (( x100 < 500 )); then
      echo "OK: до 5%, жить можно, но стоит иногда перепроверять (заметно плохо еще не видно)."
    elif (( x100 < 1000 )); then
      echo "Bad: заметный CPU contention / вероятный оверселл (плохо)."
    elif (( x100 < 2000 )); then
      echo "Very bad: VM регулярно не получает CPU (очень плохо)."
    elif (( x100 < 3000 )); then
      echo "Terrible: сильная деградация производительности (ужасно)."
    elif (( x100 < 5000 )); then
      echo "Critical: хост-нода сильно перегружена (сервер душат)."
    elif (( x100 < 7000 )); then
      echo "Severe: VM большую часть времени CPU-starved (почти неработоспособно)."
    else
      echo "Unusable: нормально работать почти невозможно (все пропало)."
    fi
  else
    if (( x100 < 100 )); then
      echo "Excellent: everything looks great, CPU steal is almost zero (normal)."
    elif (( x100 < 300 )); then
      echo "Good: CPU steal is low (only worth watching if it repeats at peak time)."
    elif (( x100 < 500 )); then
      echo "OK: below 5%, usable, but worth checking again sometimes."
    elif (( x100 < 1000 )); then
      echo "Bad: noticeable CPU contention / likely overselling (bad)."
    elif (( x100 < 2000 )); then
      echo "Very bad: the VM regularly does not receive CPU time (very bad)."
    elif (( x100 < 3000 )); then
      echo "Terrible: serious performance degradation (terrible)."
    elif (( x100 < 5000 )); then
      echo "Critical: the host node is heavily overloaded (the server is being throttled)."
    elif (( x100 < 7000 )); then
      echo "Severe: the VM is CPU-starved most of the time (almost unusable)."
    else
      echo "Unusable: normal work is almost impossible (everything is bad)."
    fi
  fi
}

read_cpu_full() {
  awk '
    /^cpu / {
      total = 0
      for (i = 2; i <= NF; i++) total += $i
      idle = $5 + $6
      print total, idle
      exit
    }
  ' /proc/stat
}

cpu_idle_x100() {
  local prev_total prev_idle total idle delta_total delta_idle
  read -r prev_total prev_idle < <(read_cpu_full)
  sleep 1
  read -r total idle < <(read_cpu_full)

  delta_total=$((total - prev_total))
  delta_idle=$((idle - prev_idle))
  if (( delta_total <= 0 )); then
    echo 0
    return
  fi

  echo $(((delta_idle * 10000 + delta_total / 2) / delta_total))
}

start_cpu_load() {
  local workers="$1"
  local i

  say "Load: starting random-number CPU generator on ${workers} vCPU..." "Нагрузка: запускаю генератор случайных чисел на ${workers} vCPU..."
  for ((i = 1; i <= workers; i++)); do
    awk 'BEGIN { srand(); while (1) { x = rand(); y = x * rand(); } }' >/dev/null &
    stress_pids+=("$!")
  done

  sleep 2
}

hostname="$(hostname -f 2>/dev/null || hostname)"
kernel="$(uname -srmo 2>/dev/null || uname -a)"
cores="$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || echo '?')"
model="$(awk -F: '/model name|Hardware|Processor/ {gsub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo 2>/dev/null || true)"
loadavg="$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null || echo '?')"
virt=""
if command -v systemd-detect-virt >/dev/null 2>&1; then
  virt="$(systemd-detect-virt 2>/dev/null || true)"
fi

echo "Host: $hostname"
echo "Kernel: $kernel"
echo "vCPU: $cores"
if [[ -n "$model" ]]; then
  echo "CPU: $model"
fi
if [[ -n "$virt" ]]; then
  echo "Virtualization: $virt"
fi
echo "Load average: $loadavg"
echo

if ! [[ "$cores" =~ ^[0-9]+$ ]] || (( cores < 1 )); then
  cores=1
fi

case "$stress_mode" in
  yes)
    start_cpu_load "$cores"
    ;;
  auto)
    idle_x100="$(cpu_idle_x100)"
    busy_x100=$((10000 - idle_x100))
    if [[ "$lang" == "ru" ]]; then
      echo "CPU сейчас: занято $(format_pct "$busy_x100"), простой $(format_pct "$idle_x100")."
    else
      echo "CPU now: busy $(format_pct "$busy_x100"), idle $(format_pct "$idle_x100")."
    fi
    if (( idle_x100 > 5000 )); then
      say "Idle is above 50%: enabling stress auto." "Простоя больше 50%: включаю stress auto."
      start_cpu_load "$cores"
    else
      say "Idle is 50% or lower: load already exists, not starting extra stress." "Простоя 50% или меньше: нагрузка уже есть, дополнительный stress не запускаю."
    fi
    echo
    ;;
  no)
    say "Load: disabled (--no-stress)." "Нагрузка: выключена (--no-stress)."
    echo
    ;;
  *)
    say "Unknown stress mode: $stress_mode" "Неизвестный режим stress: $stress_mode" >&2
    exit 2
    ;;
esac

read -r prev_total prev_steal < <(read_cpu)
sum_x100=0
max_x100=0
count=0

for ((i = 1; i <= seconds; i++)); do
  sleep 1
  read -r total steal < <(read_cpu)
  delta_total=$((total - prev_total))
  delta_steal=$((steal - prev_steal))
  prev_total="$total"
  prev_steal="$steal"

  if (( delta_total <= 0 )); then
    continue
  fi

  pct_x100=$(((delta_steal * 10000 + delta_total / 2) / delta_total))
  sum_x100=$((sum_x100 + pct_x100))
  if (( pct_x100 > max_x100 )); then
    max_x100="$pct_x100"
  fi
  count=$((count + 1))
done

if (( count == 0 )); then
  say "Could not collect CPU samples." "Не удалось собрать CPU samples." >&2
  exit 1
fi

avg_x100=$(((sum_x100 + count / 2) / count))

if [[ "$lang" == "ru" ]]; then
  echo "CPU steal средний: $(format_pct "$avg_x100")"
  echo "CPU steal макс 1s: $(format_pct "$max_x100")"
  echo "Замеров: ${count}s"
else
  echo "CPU steal average: $(format_pct "$avg_x100")"
  echo "CPU steal max 1s: $(format_pct "$max_x100")"
  echo "Samples: ${count}s"
fi
echo
interpret "$avg_x100"
echo
if (( ${#stress_pids[@]} > 0 )); then
  say "Load stopped. High steal under this load is a strong sign of CPU contention/overselling." "Нагрузка остановлена. Если steal высокий под такой нагрузкой, это хороший признак CPU contention/оверселла."
else
  say "Tip: use --stress for a clean under-load test if auto mode did not start load." "Совет: для чистого теста под нагрузкой используйте --stress, если auto-режим не включил нагрузку."
fi
REMOTE
